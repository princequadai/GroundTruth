# GroundTruth Server Environment Variables

# Server Port
PORT=5000

# Client Origin for CORS (Use * or comma-separated list of origins)
# For production on Render/Vercel: https://your-groundtruth-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# AI Inference Provider Configuration
# We use an instruction-tuned, open-weight model (Gemma 2 9B-IT)
# Supports any OpenAI-compatible provider: Groq, OpenRouter, Together AI, Ollama, etc.

# Provider API Key (Required for hosted inference)
# e.g., gsk_... for Groq, or sk-or-... for OpenRouter
AI_API_KEY=your_api_key_here

# Open-weight model identifier
# Groq: gemma2-9b-it
# OpenRouter: google/gemma-2-9b-it
# Ollama: gemma2:9b
AI_MODEL=gemma2-9b-it

# Provider base URL (default: Groq OpenAI-compatible endpoint)
# Groq: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Local Ollama: http://localhost:11434/v1
AI_API_BASE_URL=https://api.groq.com/openai/v1

# Request timeout in milliseconds (default: 30000 = 30 seconds)
AI_REQUEST_TIMEOUT_MS=30000
